#!/command/with-contenv bashio
# shellcheck shell=bash
set -euo pipefail

# nestfi-access-plan.md Phase 2 — rebased onto the HA base image + s6-overlay
# so `addon stop`/restart sends SIGTERM through s6 and turnserver shuts down
# relay allocations gracefully instead of being SIGKILLed (the alpine:3.20 +
# bare CMD version had no supervisor at all).

OPTIONS_FILE="/data/options.json"

USERNAME="$(jq -r '.username' "$OPTIONS_FILE")"
PASSWORD="$(jq -r '.password' "$OPTIONS_FILE")"
REALM="$(jq -r '.realm' "$OPTIONS_FILE")"
LISTENING_IP="$(jq -r '.listening_ip' "$OPTIONS_FILE")"
EXTERNAL_IP="$(jq -r '.external_ip' "$OPTIONS_FILE")"
MIN_PORT="$(jq -r '.min_port' "$OPTIONS_FILE")"
MAX_PORT="$(jq -r '.max_port' "$OPTIONS_FILE")"
USE_TLS="$(jq -r '.use_tls' "$OPTIONS_FILE")"
TLS_LISTENING_PORT="$(jq -r '.tls_listening_port // 5349' "$OPTIONS_FILE")"
CERT_FILE="$(jq -r '.cert_file' "$OPTIONS_FILE")"
KEY_FILE="$(jq -r '.key_file' "$OPTIONS_FILE")"
LOG_LEVEL="$(jq -r '.log_level // "info"' "$OPTIONS_FILE" | tr '[:upper:]' '[:lower:]')"

ARGS=(
  -n
  --no-cli
  --log-file=stdout
  --fingerprint
  --lt-cred-mech
  --realm="$REALM"
  --user="$USERNAME:$PASSWORD"
  --listening-ip="$LISTENING_IP"
  --relay-ip="$LISTENING_IP"
  --listening-port=3478
  --min-port="$MIN_PORT"
  --max-port="$MAX_PORT"
  --no-multicast-peers
  # Loopback peers are denied by default in modern coturn; --no-loopback-peers
  # was removed (unrecognized option aborts startup).
  --stale-nonce
)

case "$LOG_LEVEL" in
  verbose) ARGS+=(-v) ;;
  debug) ARGS+=(-V) ;;
  info|*) ;;
esac

if [[ -n "$EXTERNAL_IP" && -n "$LISTENING_IP" && "$EXTERNAL_IP" != "null" && "$LISTENING_IP" != "null" ]]; then
  ARGS+=(--external-ip="$EXTERNAL_IP/$LISTENING_IP")
fi

if [[ "$USE_TLS" == "true" ]]; then
  if [[ -r "/ssl/$CERT_FILE" && -r "/ssl/$KEY_FILE" ]]; then
    ARGS+=(
      --tls-listening-port="$TLS_LISTENING_PORT"
      --cert="/ssl/$CERT_FILE"
      --pkey="/ssl/$KEY_FILE"
      --no-tlsv1
      --no-tlsv1_1
    )
  else
    # Cert not on disk yet (e.g. Traefik hasn't finished its first ACME issuance,
    # or the cert doesn't cover the t- SAN). Don't crash-loop the add-on over it —
    # fall back to plain TURN on 3478 and let the next options push retry TLS.
    bashio::log.warning \
      "use_tls is set but /ssl/${CERT_FILE} or /ssl/${KEY_FILE} is missing; starting without TLS."
  fi
fi

# Alpine coturn tags allocation churn as DEBUG on stdout even without -v/-V.
# For log_level=info, strip those lines so Supervisor stays readable. Forward
# SIGTERM/SIGINT to turnserver so s6 stop remains graceful (turnserver is not
# PID 1 when we filter).
if [[ "$LOG_LEVEL" == "info" ]]; then
  coproc _COTURN_FILTER { grep -v --line-buffered ': DEBUG:' ; }
  turnserver "${ARGS[@]}" >&"${_COTURN_FILTER[1]}" 2>&1 &
  turn_pid=$!
  exec {_COTURN_FILTER[1]}>&-
  _forward() {
    kill -TERM "$turn_pid" 2>/dev/null || true
    wait "$turn_pid" 2>/dev/null || true
    kill "${_COTURN_FILTER_PID}" 2>/dev/null || true
  }
  trap _forward TERM INT
  wait "$turn_pid"
  rc=$?
  kill "${_COTURN_FILTER_PID}" 2>/dev/null || true
  exit "$rc"
fi

exec turnserver "${ARGS[@]}"
