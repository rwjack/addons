#!/command/with-contenv bashio
# shellcheck shell=bash
set -euo pipefail
PORT="$(bashio::core.port)"
bashio::var.json \
  "port" "^${PORT}" \
  | tempio \
    -template /etc/nginx/nginx.conf.gtpl \
    -extra stdin \
    -conf /data/options.json \
    -out /etc/nginx/nginx.conf
exec nginx -c /etc/nginx/nginx.conf
